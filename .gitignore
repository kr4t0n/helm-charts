# Vendored Helm dependencies — regenerated by `helm dependency update` (locally
# and in CI before packaging). Not committed: for file:// monorepo deps the
# Chart.lock digest changes whenever charts/common changes, which would churn
# every dependent chart's lock on each library edit.
charts/*/charts/
charts/*/Chart.lock

