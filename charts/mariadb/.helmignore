# Patterns to ignore when packaging Helm charts.
# NOTE: do not ignore *.tgz here — it would exclude the vendored `common`
# dependency under charts/ and break rendering.
.DS_Store
.git/
.gitignore
.idea/
.vscode/
*.tmproj
*.swp
*.swo
*.bak
*.orig
# chart-testing / lint values, not shipped in the package.
ci/
