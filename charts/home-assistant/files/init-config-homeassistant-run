#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# linuxserver/docker-homeassistant bc919f9 (2026.11.0-ls263) init-config-homeassistant/run,
# except that the image's Python tree is linked, not moved and chowned. See the README.

# migration
rm -rf \
    /config/lsiopy \
    /config/.local/{bin,lib}

# Add abc user to python system install owner group, lsio (7310)
if ! id -G abc | grep -qw "7310"; then
    usermod -a -G lsio abc
fi
PUID=${PUID:-911}
PY_LOCAL_PATH=$(find /usr/local/lib -maxdepth 1 -name 'python*' -type d)
PY_LOCAL_PATH="${PY_LOCAL_PATH%.bak}"
if [[ -d "${PY_LOCAL_PATH}.bak" ]] && [[ ! -e "${PY_LOCAL_PATH}" ]] && [[ ! -L "${PY_LOCAL_PATH}" ]]; then
    echo "**** Linking ${PY_LOCAL_PATH} to ${PY_LOCAL_PATH##*/}.bak instead of copying it ****"
    ln -s "${PY_LOCAL_PATH##*/}.bak" "${PY_LOCAL_PATH}"
fi
# set permissions
echo "Setting permissions"
lsiown -R abc:abc \
    /config
